<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>AI Sentiment Analyzer</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e3a8a);
      color: white;
    }

    .card {
      width: 90%;
      max-width: 500px;
      padding: 35px;
      border-radius: 20px;
      background: rgba(255,255,255,0.1);
      backdrop-filter: blur(15px);
      box-shadow: 0 20px 50px rgba(0,0,0,0.3);
      text-align: center;
    }

    h1 {
      margin-bottom: 10px;
    }

    .subtitle {
      color: #cbd5e1;
      margin-bottom: 25px;
    }

    textarea {
      width: 100%;
      height: 120px;
      padding: 15px;
      border-radius: 12px;
      border: none;
      resize: none;
      font-size: 16px;
      outline: none;
    }

    button {
      width: 100%;
      margin-top: 15px;
      padding: 14px;
      border: none;
      border-radius: 12px;
      background: #3b82f6;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #2563eb;
    }

    #result {
      margin-top: 25px;
      font-size: 24px;
      font-weight: bold;
      min-height: 35px;
    }

    .positive {
      color: #4ade80;
    }

    .negative {
      color: #f87171;
    }

    .loading {
      color: #facc15;
    }
  </style>
</head>

<body>

  <div class="card">

    <h1>🤖 AI Sentiment Analyzer</h1>

    <p class="subtitle">
      Let AI understand the emotion behind your sentence.
    </p>

    <textarea
      id="textInput"
      placeholder="Type your sentence here..."
    ></textarea>

    <button onclick="analyze()">
      Analyze Sentiment
    </button>

    <div id="result"></div>

  </div>

  <script>
    async function analyze() {

      const text = document.getElementById("textInput").value.trim();
      const result = document.getElementById("result");

      if (!text) {
        result.className = "negative";
        result.innerText = "Please enter a sentence.";
        return;
      }

      result.className = "loading";
      result.innerText = "🤖 AI is analyzing...";

      try {

        const response = await fetch("/api/analyze", {
          method: "POST",

          headers: {
            "Content-Type": "application/json"
          },

          body: JSON.stringify({
            text: text
          })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || "Something went wrong.");
        }

        if (data.result === "Positive") {
          result.className = "positive";
          result.innerText = "😊 Positive";
        } else {
          result.className = "negative";
          result.innerText = "😡 Negative";
        }

      } catch (error) {

        result.className = "negative";
        result.innerText = "❌ " + error.message;

      }
    }
  </script>

</body>
</html>
